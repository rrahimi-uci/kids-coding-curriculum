%% kidscode-colors.sty -- the one color palette of the Kids Coding curriculum.
%%
%% Used by kidscode.cls (all printed documents) and by the parent slide deck
%% theme (parents/beamerthemekidscode.sty), so every document shares one
%% palette. All hues are from the Okabe-Ito color-blind-safe palette
%% (Okabe & Ito, 2008). Colored elements must also carry a word or icon, so
%% meaning never depends on color alone.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{kidscode-colors}[2026/11/08 Kids Coding color palette]
\RequirePackage{xcolor}
\definecolor{kcorange}{HTML}{E69F00}
\definecolor{kcsky}{HTML}{56B4E9}
\definecolor{kcgreen}{HTML}{009E73}
\definecolor{kcyellow}{HTML}{F0E442}
\definecolor{kcblue}{HTML}{0072B2}
\definecolor{kcvermillion}{HTML}{D55E00}
\definecolor{kcpurple}{HTML}{CC79A7}
\definecolor{kcblack}{HTML}{000000}
\definecolor{kcgray}{HTML}{555555}
\definecolor{kcpaper}{HTML}{FFFFFF}
%% Text-safe darker shades (>= 4.5:1 contrast on white) for colored words.
\definecolor{kcbluetext}{HTML}{005A8C}
\definecolor{kcgreentext}{HTML}{00694D}
\definecolor{kcvermilliontext}{HTML}{A64A00}
\definecolor{kcorangetext}{HTML}{8A5F00}
\definecolor{kcpurpletext}{HTML}{8E4672}
\definecolor{kcink}{HTML}{1B1F24}
\endinput
