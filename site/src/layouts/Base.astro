---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { u, siteInfo, bands, bandLevels, resources, BAND_INFO } from '../lib/data';
// The three fonts almost every page uses: fetched early so text does not reflow when they arrive.
import fontRegular from '../fonts/atkinson-regular.woff2?url';
import fontBold from '../fonts/atkinson-bold.woff2?url';
import fontMono from '../fonts/atkinson-mono-regular.woff2?url';

// redirect: the new address of a page that moved (old /levels/level-N/ links); the page then only points there.
interface Props { title: string; description?: string; level?: number; pagefind?: boolean; noindex?: boolean; redirect?: string; }
const { title, description = 'A free, friendly programming course for kids: Scratch, then Python. Lessons, exercises and projects for families.', level, redirect } = Astro.props;
const pagefind = redirect ? false : (Astro.props.pagefind ?? true);
const noindex = redirect ? true : (Astro.props.noindex ?? false);
const info = siteInfo();
const path = Astro.url.pathname;
const rel = path.replace(u(''), '/');
const full = title.includes('Kids Coding') ? title : `${title} | Kids Coding`;
const canonical = new URL(redirect ?? path, Astro.site).href;

// ---- Site navigation (one source for the sidebar). Groups follow the order a family meets the course:
// orientation (home, parents, curriculum), the learning path (grade band > level > weeks), then reference material.
const B = bands();
const R = resources();
const here = (p: string) => rel === p;                    // exactly this page
const within = (p: string) => rel.startsWith(p);         // this section
// Exercise pages live at /<band>/level-N/exercises/weekNN-.../: they belong to that week in the menu.
const exWeek = rel.match(/^\/(grade-[\d-]+\/level-\d)\/exercises\/week(\d\d)-/);
const inWeek = (lpath: string, wslug: string) =>
  rel.startsWith(`/${lpath}/${wslug}/`) || (!!exWeek && exWeek[1] === lpath && `week-${exWeek[2]}` === wslug);
const cur = (on: boolean) => (on ? 'page' : undefined);
const resIcon: Record<string, string> = { 'setup-mac': 'wrench', troubleshooting: 'lifebuoy' };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex" />}
    {redirect && <meta http-equiv="refresh" content={`0; url=${redirect}`} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
    {[fontRegular, fontBold, fontMono].map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline>
      /* Before first paint: mark that JavaScript runs and apply the saved color theme. */
      try {
        var d = document.documentElement, t = localStorage.getItem('kc:theme');
        d.classList.add('js');
        if (t) d.setAttribute('data-theme', t);
      } catch (e) {}
    </script>
  </head>
  <body class={level ? `l${level}` : undefined} data-base={u('')}>
    <a class="skip-link" href="#main">Skip to content</a>
    <button class="icon-btn theme-corner" type="button" id="theme-toggle" aria-pressed="false" aria-label="Use dark mode" title="Use dark mode"><Icon name="moon" /></button>

    <!-- Phone and tablet: a slim top bar opens the same navigation as a drawer. -->
    <header class="topbar">
      <button class="icon-btn menu-btn" type="button" aria-controls="sidebar" aria-expanded="false"><Icon name="menu" /><span class="visually-hidden">Open the menu</span></button>
      <a class="brand" href={u('')}><svg class="logo" viewBox="0 0 32 32" aria-hidden="true"><rect x="2" y="3" width="13" height="7" rx="2.5" fill="#E69F00"/><rect x="2" y="12.5" width="19" height="7" rx="2.5" fill="#0072B2"/><rect x="2" y="22" width="15" height="7" rx="2.5" fill="#009E73"/><path d="M24 8l6 8-6 8" fill="none" stroke="#D55E00" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Kids Coding</span></a>
      <a class="icon-btn" href={u('search/')}><Icon name="search" /><span class="visually-hidden">Search</span></a>
    </header>

    <div class="shell">
      <aside class="sidebar" id="sidebar" aria-label="Site">
        <div class="sidebar-head">
          <a class="brand" href={u('')} aria-label="Kids Coding, home"><svg class="logo" viewBox="0 0 32 32" aria-hidden="true"><rect x="2" y="3" width="13" height="7" rx="2.5" fill="#E69F00"/><rect x="2" y="12.5" width="19" height="7" rx="2.5" fill="#0072B2"/><rect x="2" y="22" width="15" height="7" rx="2.5" fill="#009E73"/><path d="M24 8l6 8-6 8" fill="none" stroke="#D55E00" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Kids Coding</span></a>
          <button class="icon-btn close-btn" type="button" aria-controls="sidebar"><Icon name="x" /><span class="visually-hidden">Close the menu</span></button>
        </div>

        <form class="side-search" action={u('search/')} method="get" role="search">
          <label class="visually-hidden" for="side-q">Search the site</label>
          <input id="side-q" name="q" type="search" placeholder="Search lessons" autocomplete="off" />
          <button class="search-submit" type="submit"><Icon name="search" /><span class="visually-hidden">Search</span></button>
        </form>

        <nav class="side-nav" aria-label="Main">
          <ul class="nav-list">
            <li><a class="nav-link" href={u('')} aria-current={cur(here('/'))}><Icon name="home" />Home</a></li>
            <li><a class="nav-link" href={u('curriculum/')} aria-current={cur(here('/curriculum/'))}><Icon name="map" />Curriculum and timeline</a></li>
          </ul>

          {B.map((b) => (
            <>
              <p class="nav-heading">{b.band_title} <span class="sub">{BAND_INFO[b.id].short}</span></p>
              <ul class="nav-list">
                <li><a class="nav-link" href={u(`${b.id}/`)} aria-current={cur(here(`/${b.id}/`))}><Icon name="map" />Overview</a></li>
                {bandLevels(b.id).map((l) => {
                  const base = `/${l.path}/`;
                  return (
                    <li class={`l${l.number}`}>
                      <details class="nav-group" open={within(base) || within(`/parents/notes/${l.path}/`) ? true : undefined}>
                        <summary class="nav-link"><span class="level-dot" aria-hidden="true">{l.number}</span><span class="grow">Level {l.number}<span class="visually-hidden">, {b.band_title}</span><span class="sub">{l.name}</span></span><Icon name="chevron-down" class="chev" /></summary>
                        <ul class="nav-sub">
                          <li><a href={u(`${l.path}/`)} aria-current={cur(here(base))}>Overview</a></li>
                          {l.weeks.length > 0 && (
                            <li class="nav-weeks">
                              <span class="nav-subhead">Weeks</span>
                              <ol>
                                {l.weeks.map((w: any) => <li><a href={u(`${l.path}/${w.slug}/`)} aria-current={inWeek(l.path, w.slug) ? (here(`${base}${w.slug}/`) ? 'page' : 'location') : undefined}><span class="wk">{w.n}</span><span class="wt" set:html={w.title} /></a></li>)}
                              </ol>
                            </li>
                          )}
                          {l.project && <li><a href={u(`${l.path}/project/`)} aria-current={cur(here(`${base}project/`))}>Final project</a></li>}
                          {l.extras?.cheat_sheet && <li><a href={u(`${l.path}/cheat-sheet/`)} aria-current={cur(here(`${base}cheat-sheet/`))}>Cheat sheet</a></li>}
                          {l.extras?.parent_notes && <li><a href={u(`parents/notes/${l.path}/`)} aria-current={cur(here(`/parents/notes/${l.path}/`))}>Notes for families</a></li>}
                        </ul>
                      </details>
                    </li>
                  );
                })}
              </ul>
            </>
          ))}

          <p class="nav-heading">For parents</p>
          <ul class="nav-list">
            <li><a class="nav-link" href={u('parents/')} aria-current={cur(here('/parents/'))}><Icon name="users" />Parent guide</a></li>
            <li><a class="nav-link" href={u('parents/research/')} aria-current={cur(here('/parents/research/'))}><Icon name="flask" />What the research says</a></li>
            <li><a class="nav-link" href={u('parents/slides/')} aria-current={cur(here('/parents/slides/'))}><Icon name="presentation" />Information slides</a></li>
            <li><a class="nav-link" href={u('parents/faq/')} aria-current={cur(here('/parents/faq/'))}><Icon name="help" />Questions and answers</a></li>
          </ul>

          <p class="nav-heading">Resources</p>
          <ul class="nav-list">
            {R.map((r) => <li><a class="nav-link" href={u(`resources/${r.slug}/`)} aria-current={cur(here(`/resources/${r.slug}/`))}><Icon name={resIcon[r.slug] ?? 'file-text'} />{r.title}</a></li>)}
            <li><a class="nav-link" href={u('resources/glossary/')} aria-current={cur(here('/resources/glossary/'))}><Icon name="book" />Glossary</a></li>
            <li><a class="nav-link" href={u('resources/')} aria-current={cur(here('/resources/'))}><Icon name="folder" />All resources</a></li>
            <li><a class="nav-link" href={u('about/')} aria-current={cur(here('/about/'))}><Icon name="info" />About this site</a></li>
          </ul>
        </nav>

      </aside>
      <div class="scrim" hidden></div>

      <div class="content">
        <main id="main" data-pagefind-body={pagefind ? '' : undefined}>
          <div class="wrap">
            <slot />
          </div>
        </main>
        <footer class="site-footer">
          <div class="wrap">
            <p><strong>Kids Coding</strong>: a free course for children in Grades 2–6, one session a week. Grades 2–3 play robot games and build in Scratch; Grades 4–6 go from Scratch blocks to Python.</p>
            <p class="foot-meta"><span><Icon name="lock" /> No accounts, no ads, no tracking</span><span>Version {info.version}, updated <time datetime={info.updated}>{info.updated}</time></span><a href={u('about/#changelog')}>What changed</a><a href={u('about/')}>Accessibility and credits</a></p>
          </div>
        </footer>
      </div>
    </div>
    <script src="../scripts/site.js"></script>
  </body>
</html>
