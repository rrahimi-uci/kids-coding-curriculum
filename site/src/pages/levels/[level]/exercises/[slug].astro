---
import Base from '../../../../layouts/Base.astro';
import Icon from '../../../../components/Icon.astro';
import { u, levels, exercises, fix } from '../../../../lib/data';
export function getStaticPaths() {
  const out: any[] = [];
  for (const l of levels()) for (const e of exercises(l.slug)) out.push({ params: { level: l.slug, slug: e.slug }, props: { l, e } });
  return out;
}
const { l, e } = Astro.props;
const wk = l.weeks.find((w: any) => w.n === e.week);
const label = e.homework ? 'Homework exercise' : `Exercise ${e.number}`;
const junior = l.track === 'junior';
---
<Base title={`${junior ? `${l.label}, ` : ''}${label}: ${e.title}`} level={l.number} description={`${label} in week ${e.week}: ${e.title}. Steps, starter code and hints.`}>
  <div class={`l${l.number}`}>
    <nav class="breadcrumb" aria-label="Breadcrumb"><ol>
      <li><a href={u('curriculum/')}>Curriculum</a></li><li><a href={u(`levels/${l.slug}/`)}>{l.label}</a></li>
      <li><a href={u(`levels/${l.slug}/week-${String(e.week).padStart(2, '0')}/`)}>Week {e.week}</a></li><li aria-current="page">{e.title}</li></ol></nav>
    <header class="page-head stack">
      <p class="eyebrow accent-text">{junior && `${l.label} · `}{label} · Week {e.week}</p>
      <h1>{e.title}</h1>
      <p><span class="pill">{e.kind === 'python' ? 'Python in Thonny' : 'Scratch (offline app)'}</span> <span class="pill">{junior ? 'Driver and Helper' : 'Work in pairs'}</span></p>
    </header>

    <div class="lesson measure">
      <div set:html={fix(e.body)} />

      {e.starter && (
        <section aria-labelledby="starter">
          <h2 id="starter">Starter code</h2>
          <p>Open <code>{e.starter.name}</code> in Thonny, or copy the code below into a new file and save it as <code>{e.starter.name}</code>.</p>
          <div class="starter-code" style="position:relative">
            <pre tabindex="0"><code class="language-python" set:html={e.starter.html} /></pre>
          </div>
          <div class="btn-row">
            <a class="btn secondary small" href={u(`downloads/${l.slug}/exercises/${e.slug}/${e.starter.name}`)} download><Icon name="download" /> Download {e.starter.name}</a>
          </div>
        </section>
      )}

      <section aria-labelledby="hints">
        <h2 id="hints">Stuck? Read a hint</h2>
        <p class="hint-note">Try on your own first. Read the hints in order, from a small nudge to a bigger one. None of them gives the answer away.</p>
        <div class="hints">
          {e.hints.map((h: any) => (
            <section class="hint">
              <h3 class="hint-title">{h.label}: {h.title}</h3>
              <div class="body" set:html={fix(h.html)} />
            </section>
          ))}
        </div>
      </section>
      <div class="btn-row">
        <a class="btn secondary" href={u(`levels/${l.slug}/week-${String(e.week).padStart(2, '0')}/`)}><Icon name="back" /> Back to week {e.week}</a>
      </div>
      {junior
        ? <p class="small muted">Grown-ups: check the work together. Does it do what the steps say{e.kind === 'python' ? ' and look like the picture in "What you should see"' : ''}? If not, read the next hint.</p>
        : <p class="small muted">Parents: the course folder has an automatic self-check script for the Python exercises. It is not on this website because it relies on test files that give away the answers.</p>}
    </div>
  </div>
</Base>
