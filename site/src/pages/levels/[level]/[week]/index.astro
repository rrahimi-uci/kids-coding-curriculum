---
import Base from '../../../../layouts/Base.astro';
import Icon from '../../../../components/Icon.astro';
import { u, levels, weekHtml, homeworkHtml, fix } from '../../../../lib/data';
export function getStaticPaths() {
  const out: any[] = [];
  for (const l of levels()) {
    l.weeks.forEach((w, i) => out.push({ params: { level: l.slug, week: w.slug }, props: { l, w, prev: l.weeks[i - 1], next: l.weeks[i + 1] } }));
  }
  return out;
}
const { l, w, prev, next } = Astro.props;
const body = weekHtml(l.slug, w.slug);
const hw = w.has_homework ? homeworkHtml(l.slug, w.slug) : '';
const inClass = w.exercises.filter((e: any) => !e.homework);
const hwEx = w.exercises.filter((e: any) => e.homework);
const toc = [
  ...w.toc.filter((t: any) => t.level === 2),
].map((t: any) => t);
---
<Base title={`Level ${l.number}, week ${w.n}: ${w.title}`} level={l.number} description={w.idea}>
  <div class={`l${l.number}`}>
    <nav class="breadcrumb" aria-label="Breadcrumb"><ol>
      <li><a href={u('curriculum/')}>Curriculum</a></li><li><a href={u(`levels/${l.slug}/`)}>Level {l.number}</a></li><li aria-current="page">Week {w.n}</li></ol></nav>
    <header class="page-head stack">
      <p class="eyebrow accent-text">Level {l.number} · {l.name} · Week {w.n}</p>
      <h1>{w.title}</h1>
      <p class="idea">{w.idea}</p>
      <div class="objectives" data-pagefind-weight="2">
        <h2>What you will learn</h2>
        <ul>{w.objectives.map((o: string) => <li>{o}</li>)}</ul>
      </div>
      <div class="btn-row">
        {w.downloads.pdf && <a class="btn secondary small" href={fix(w.downloads.pdf.url)}><Icon name="download" /> Print this week (PDF, {w.downloads.pdf.kb} KB)</a>}
        {w.downloads.starter && <a class="btn secondary small" href={fix(w.downloads.starter.url)}><Icon name="download" /> Starter files (ZIP)</a>}
      </div>
    </header>

    <div class="lesson-layout">
      <aside class="lesson-side" aria-label="On this page">
        <nav class="toc" aria-label="Table of contents">
          <details>
            <summary>On this page</summary>
            <ol>
              {w.video && <li><a href="#watch">Watch the video</a></li>}
              {toc.map((t: any) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}
              {inClass.length > 0 && <li><a href="#exercises">Exercises</a></li>}
              {w.vocab.length > 0 && <li><a href="#words">New words</a></li>}
              {w.has_homework && <li><a href="#homework">Homework</a></li>}
            </ol>
          </details>
        </nav>
      </aside>
      <div class="lesson" id="lesson">
        {w.video && (
          <section class="lesson-video" aria-labelledby="watch">
            <h2 id="watch">Watch the video <span class="muted">({w.video.minutes} min)</span></h2>
            <div class="video-frame">
              <video controls preload="none" playsinline width="1280" height="720" poster={fix(w.video.poster)}
                aria-label={`Video: Level ${l.number}, week ${w.n}: ${w.title}`}>
                <source src={fix(w.video.src)} type="video/mp4" />
                <track kind="captions" src={fix(w.video.captions)} srclang="en" label="English" default />
                <a href={fix(w.video.src)}>Download the video (MP4, {w.video.mb} MB)</a>
              </video>
            </div>
            <p class="video-note small muted">Captions are on; turn them off with the CC button. The narration uses computer-generated voices.</p>
            <details class="more video-script">
              <summary>Read the script</summary>
              {w.video.transcript.map((para: string) => <p>{para}</p>)}
            </details>
          </section>
        )}
        <div set:html={body} />

        {inClass.length > 0 && (
          <section aria-labelledby="exercises">
            <h2 id="exercises">Exercises for this week</h2>
            <p class="muted">Each exercise has the steps, the starter code and hints that open one at a time.</p>
            <ul class="ex-list">
              {inClass.map((e: any) => <li><a class="ex-link" href={fix(e.url)}><span class="no">{e.number}</span><span><strong>{e.title}</strong> <span class="pill">{e.kind === 'python' ? 'Python in Thonny' : 'Scratch'}</span></span></a></li>)}
            </ul>
          </section>
        )}

        {w.vocab.length > 0 && (
          <section aria-labelledby="words">
            <h2 id="words">New words</h2>
            <div class="callout callout-vocab" role="note">
              <dl class="vocab-list">
                {w.vocab.map((v: any) => <><dt>{v.term}</dt><dd>{v.def}</dd></>)}
              </dl>
            </div>
          </section>
        )}

        {w.has_homework && (
          <section aria-labelledby="homework">
            <h2 id="homework">Homework: {w.homework_title}</h2>
            <p class="muted">{w.homework_note}</p>
            <div set:html={hw} />
            {hwEx.length > 0 && <ul class="ex-list">{hwEx.map((e: any) => <li><a class="ex-link" href={fix(e.url)}><span class="no">HW</span><span><strong>{e.title}</strong>: hints and starter code</span></a></li>)}</ul>}
          </section>
        )}
      </div>
    </div>

    <nav class="pagination" aria-label="Previous and next week">
      {prev ? <a class="card prev" href={u(`levels/${l.slug}/${prev.slug}/`)}><span class="small muted">Previous</span><br /><strong>Week {prev.n}: {prev.title}</strong></a> : <span></span>}
      {next ? <a class="card next" href={u(`levels/${l.slug}/${next.slug}/`)}><span class="small muted">Next</span><br /><strong>Week {next.n}: {next.title}</strong></a> : <span></span>}
    </nav>
  </div>
</Base>
