---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import { u, levels, levelHtml, fix } from '../../../lib/data';
export function getStaticPaths() { return levels().filter((l) => l.project).map((l) => ({ params: { level: l.slug }, props: { l } })); }
const { l } = Astro.props;
const p = l.project!;
const body = levelHtml(l.slug, 'project');
const dl = l.extra_downloads?.['project-brief'] ?? {};
const hasStarter = !!p.zip;  // Junior Levels 1 and 2 start in Scratch and have no starter files
---
<Base title={`${l.label} final project: ${l.project_title}`} level={l.number} description={`The ${l.label} final project brief${hasStarter ? ', rubric and starter files' : ' and plan'}: ${l.project_title}.`}>
  <div class={`l${l.number}`}>
    <nav class="breadcrumb" aria-label="Breadcrumb"><ol><li><a href={u('curriculum/')}>Curriculum</a></li><li><a href={u(`levels/${l.slug}/`)}>{l.label}</a></li><li aria-current="page">Final project</li></ol></nav>
    <header class="page-head stack">
      <p class="eyebrow accent-text">{l.label} · {l.name} · Final project</p>
      <h1>{l.project_title}</h1>
      <p class="lead">{l.track === 'junior'
        ? `The project brief to read together, with the plan${hasStarter ? ', plus the starter file to begin from' : ''}.`
        : 'The project brief with the plan sheet and the rubric, plus the starter files to begin from.'}</p>
      <div class="btn-row">
        {hasStarter && <a class="btn small" href="#starter"><Icon name="arrow" /> Jump to the starter files</a>}
        {dl.standard && <a class="btn secondary small" href={fix(dl.standard.url)}><Icon name="download" /> Print the brief (PDF, {dl.standard.kb} KB)</a>}
        {dl.dyslexia && <a class="btn secondary small" href={fix(dl.dyslexia.url)}><Icon name="download" /> Dyslexia-friendly edition (PDF)</a>}
      </div>
    </header>
    <div class="lesson-layout">
      <aside class="lesson-side" aria-label="On this page">
        <nav class="toc" aria-label="Table of contents"><details><summary>On this page</summary><ol>
          {p.toc.filter((t) => t.level === 2).map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}
          {hasStarter && <li><a href="#starter">Starter files</a></li>}
        </ol></details></nav>
      </aside>
      <div class="lesson">
        <div set:html={fix(body)} />
        {p.zip && (
        <section aria-labelledby="starter">
          <h2 id="starter">Starter files</h2>
          <p>{l.track === 'junior' ? 'For the Python postcard: this program already runs and draws a picture. Change it, one line at a time, to make it yours.' : 'These are templates to start from. They run, but the interesting parts are yours to write.'}</p>
          <div class="btn-row"><a class="btn small" href={fix(p.zip.url)}><Icon name="download" /> All starter files (ZIP, {p.zip.kb} KB)</a></div>
          <div set:html={fix(p.starter_readme)} />
          {p.starter_files.filter((f) => f.html).map((f) => (
            <div>
              <h3 id={`file-${f.name.replace(/[^a-z0-9]+/gi, '-')}`}>{f.name}</h3>
              <div class="starter-code" style="position:relative"><pre tabindex="0"><code class="language-python" set:html={f.html} /></pre></div>
              <div class="btn-row"><a class="btn secondary small" href={fix(f.url)} download><Icon name="download" /> Download {f.name}</a></div>
            </div>
          ))}
          {p.starter_files.filter((f) => !f.html).length > 0 && <p>Data files: {p.starter_files.filter((f) => !f.html).map((f, i) => <><a href={fix(f.url)} download>{f.name}</a>{i < p.starter_files.filter((x) => !x.html).length - 1 ? ', ' : ''}</>)}</p>}
        </section>
        )}
        <nav class="pagination" aria-label="Back to the level"><a class="card prev" href={u(`levels/${l.slug}/`)}><span class="small muted">Back to</span><br /><strong>{l.label}: {l.name}</strong></a><span></span></nav>
      </div>
    </div>
  </div>
</Base>
