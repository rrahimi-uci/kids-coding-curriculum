---
import Base from '../layouts/Base.astro';
import { u } from '../lib/data';
---
<Base title="Page not found" noindex pagefind={false}>
  <div class="measure stack">
    <h1>Oops, that page is not here</h1>
    <p class="lead">The link may be old, or the page may have moved.</p>
    <div class="btn-row"><a class="btn" href={u('')}>Go to the home page</a><a class="btn secondary" href={u('search/')}>Search the site</a></div>
  </div>
</Base>
