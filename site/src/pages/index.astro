---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { u, bands, bandLevels, BAND_INFO } from '../lib/data';
const B = bands();
---
<Base title="Kids Coding: learn to code by making games and art" level={undefined}>
  <section class="hero">
    <div>
      <p class="eyebrow">A free course for Grades 2–6</p>
      <h1>Learn to code by making <span class="em">games and art</span>.</h1>
      <p class="lead">Two age groups with three friendly levels each, one session a week. Children start with robot games and Scratch blocks and grow into real Python, with projects they care about. Parents do not need to know how to code.</p>
      <div class="btn-row">
        {B.map((b, i) => <a class={i === 0 ? 'btn' : 'btn secondary'} href={u(`${b.id}/`)}>{b.band_title} <Icon name="arrow" /></a>)}
        <a class="btn secondary" href={u('parents/')}>I am a parent</a>
      </div>
      <ul class="trust">
        <li><Icon name="lock" /> No accounts or sign-ups</li>
        <li><Icon name="wifi" /> Works offline in class</li>
        <li><Icon name="heart" /> Free to use</li>
      </ul>
    </div>
    <div class="hero-art" aria-hidden="true">
      <svg viewBox="0 0 360 300" role="img" aria-label="">
        <rect x="14" y="20" width="128" height="40" rx="12" fill="#E69F00"/><rect x="14" y="74" width="170" height="40" rx="12" fill="#0072B2"/>
        <rect x="14" y="128" width="140" height="40" rx="12" fill="#009E73"/><rect x="14" y="182" width="190" height="40" rx="12" fill="#CC79A7"/>
        <rect x="14" y="236" width="110" height="40" rx="12" fill="#56B4E9"/>
        <path d="M214 148h34M238 136l12 12-12 12" fill="none" stroke="#555" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
        <g fill="#1b1f24"><rect x="266" y="26" width="80" height="9" rx="4"/><rect x="278" y="80" width="62" height="9" rx="4"/><rect x="266" y="134" width="90" height="9" rx="4"/><rect x="290" y="188" width="56" height="9" rx="4"/><rect x="266" y="242" width="70" height="9" rx="4"/></g>
      </svg>
    </div>
  </section>

  <section aria-labelledby="bands" class="path-cards">
    <h2 id="bands">Choose your child's grade</h2>
    <div class="grid cols-2">
      {B.map((b, i) => (
        <a class={`card accent band-card l${i + 1}`} href={u(`${b.id}/`)}>
          <p class="num">{b.band_title} · ages {b.ages}</p>
          <h3>{BAND_INFO[b.id].short}</h3>
          <p>{BAND_INFO[b.id].blurb}</p>
          <p class="small muted">{BAND_INFO[b.id].session}.</p>
        </a>
      ))}
    </div>
  </section>

  {B.map((b) => (
    <section aria-labelledby={`levels-${b.id}`}>
      <h2 id={`levels-${b.id}`}>{b.band_title}: three levels</h2>
      <div class="grid cols-3">
        {bandLevels(b.id).map((l) => (
          <a class={`card accent level-card l${l.number}`} href={u(`${l.path}/`)}>
            <p class="num">{b.band_title} · Level {l.number}</p>
            <h3>{l.name}</h3>
            <p>{BAND_INFO[b.id].levelBlurb[l.number]}</p>
            <p class="small muted"><strong>Final project:</strong> {l.project_title}</p>
          </a>
        ))}
      </div>
    </section>
  ))}
  <p><a href={u('curriculum/')}>See the full roadmap and timeline <Icon name="arrow" /></a> · <a href={u('resources/')}>Setup guides, cheat sheets and glossary <Icon name="arrow" /></a></p>

  <section aria-labelledby="parents-students" class="path-cards">
    <h2 id="parents-students">Where would you like to start?</h2>
    <div class="grid cols-2">
      <a class="card accent l1" href={u('parents/')}>
        <h3>For parents</h3>
        <p>What the research says, what a session looks like, how to help at home, and your questions answered. Includes the information-evening slides.</p>
      </a>
      <a class="card accent l2" href={u('curriculum/')}>
        <h3>For students</h3>
        <p>Pick your grade and level, open this week's page, and build the exercises. The hints go from a small nudge to a bigger one.</p>
      </a>
    </div>
  </section>

  <section aria-labelledby="week">
    <h2 id="week">What a session looks like</h2>
    <ol class="steps">
      <li><strong>Warm-up</strong> A quick game, often without a computer.</li>
      <li><strong>New idea</strong> One idea, explained with a picture or an analogy.</li>
      <li><strong>Watch and try</strong> A short live demo, then your turn.</li>
      <li><strong>Build in pairs</strong> Driver and navigator swap often.</li>
      <li><strong>Show and tell</strong> Share what you made, then read through the self-check list.</li>
    </ol>
  </section>
</Base>
