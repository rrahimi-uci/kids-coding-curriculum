---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import { u, levels, levelHtml, fix } from '../../../lib/data';
export function getStaticPaths() { return levels().filter((l) => l.extras?.parent_notes).map((l) => ({ params: { level: l.slug }, props: { l } })); }
const { l } = Astro.props;
const dl = l.extra_downloads?.['parent-notes'] ?? {};
---
<Base title={`Notes for families: Level ${l.number}`} level={l.number} description={`What children learn in Level ${l.number}, how we keep them safe and how families can help.`}>
  <div class={`l${l.number}`}>
    <nav class="breadcrumb" aria-label="Breadcrumb"><ol><li><a href={u('parents/')}>For parents</a></li><li aria-current="page">Level {l.number} notes</li></ol></nav>
    <header class="page-head stack">
      <p class="eyebrow accent-text">Level {l.number} · {l.name}</p>
      <h1>Notes for families: Level {l.number}</h1>
      <p class="lead">{l.extras!.parent_notes.subtitle}</p>
      <div class="btn-row">
        {dl.standard && <a class="btn secondary small" href={fix(dl.standard.url)}><Icon name="download" /> Print the letter (PDF, {dl.standard.kb} KB)</a>}
      </div>
    </header>
    <div class="lesson measure" set:html={levelHtml(l.slug, 'parent-notes')} />
  </div>
</Base>
