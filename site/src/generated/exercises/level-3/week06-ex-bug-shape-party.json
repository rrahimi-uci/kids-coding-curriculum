 "starter": {
  "name": "starter.py",
  "raw": "# Bug Hunt 4: Shape Party\n# Hexagons and diamonds should dance across the screen in 7 colors.\n# There are 3 bugs: one \"nothing happens at all\" bug, one crash, and one\n# shape that comes out wrong. Find them with Run, the error message and\n# the Thonny debugger.\n\nimport turtle\n\nPALETTE = [\"#E69F00\", \"#56B4E9\", \"#009E73\", \"#F0E442\",\n           \"#0072B2\", \"#D55E00\", \"#CC79A7\"]\n\n\nclass Shape:\n    def __init__(self, x, y, size, color):\n        self.x = x\n        self.y = y\n        self.size = size\n        self.color = color\n\n    def start(self, t):\n        t.penup()\n        t.goto(self.x, self.y)\n        t.setheading(0)\n        t.pendown()\n        t.color(\"black\", self.color)\n\n    def draw(self, t):\n        self.start(t)\n        t.dot(self.size, self.color)\n\n\nclass Hexagon(Shape):\n    def __init__(self, x, y, size, color, label=\"hex\"):\n        self.label = label\n\n    def draw(self, t):\n        self.start(t)\n        t.begin_fill()\n        for _ in range(6):\n            t.forward(self.size)\n            t.left(60)\n        t.end_fill()\n\n\nclass Diamond(Shape):\n    def drow(self, t):\n        self.start(t)\n        t.left(45)\n        t.begin_fill()\n        for _ in range(4):\n            t.forward(self.size)\n            t.left(90)\n        t.end_fill()\n\n\ndef draw_party(shapes, t):\n    for shape in shapes:\n        shape.draw\n\n\ndef make_party():\n    shapes = []\n    for i in range(7):\n        x = -330 + i * 100\n        if i % 2 == 0:\n            shapes.append(Hexagon(x, 40, 40, PALETTE[i]))\n        else:\n            shapes.append(Diamond(x + 30, -80, 55, PALETTE[i]))\n    return shapes\n\n\nif __name__ == \"__main__\":\n    screen = turtle.Screen()\n    screen.title(\"Shape Party\")\n    screen.tracer(0)\n    pen = turtle.Turtle()\n    pen.hideturtle()\n    pen.pensize(2)\n    draw_party(make_party(), pen)\n    screen.update()\n    turtle.done()\n",
  "html": "<span class=\"tok-c1\"># Bug Hunt 4: Shape Party</span>\n<span class=\"tok-c1\"># Hexagons and diamonds should dance across the screen in 7 colors.</span>\n<span class=\"tok-c1\"># There are 3 bugs: one &quot;nothing happens at all&quot; bug, one crash, and one</span>\n<span class=\"tok-c1\"># shape that comes out wrong. Find them with Run, the error message and</span>\n<span class=\"tok-c1\"># the Thonny debugger.</span>\n\n<span class=\"tok-kn\">import</span> <span class=\"tok-nn\">turtle</span>\n\n<span class=\"tok-n\">PALETTE</span> <span class=\"tok-o\">=</span> <span class=\"tok-p\">[</span><span class=\"tok-s2\">&quot;#E69F00&quot;</span><span class=\"tok-p\">,</span> <span class=\"tok-s2\">&quot;#56B4E9&quot;</span><span class=\"tok-p\">,</span> <span class=\"tok-s2\">&quot;#009E73&quot;</span><span class=\"tok-p\">,</span> <span class=\"tok-s2\">&quot;#F0E442&quot;</span><span class=\"tok-p\">,</span>\n           <span class=\"tok-s2\">&quot;#0072B2&quot;</span><span class=\"tok-p\">,</span> <span class=\"tok-s2\">&quot;#D55E00&quot;</span><span class=\"tok-p\">,</span> <span class=\"tok-s2\">&quot;#CC79A7&quot;</span><span class=\"tok-p\">]</span>\n\n\n<span class=\"tok-k\">class</span> <span class=\"tok-nc\">Shape</span><span class=\"tok-p\">:</span>\n    <span class=\"tok-k\">def</span> <span class=\"tok-fm\">__init__</span><span class=\"tok-p\">(</span><span class=\"tok-bp\">self</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">x</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">y</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">size</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">color</span><span class=\"tok-p\">):</span>\n        <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">x</span> <span class=\"tok-o\">=</span> <span class=\"tok-n\">x</span>\n        <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">y</span> <span class=\"tok-o\">=</span> <span class=\"tok-n\">y</span>\n        <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">size</span> <span class=\"tok-o\">=</span> <span class=\"tok-n\">size</span>\n        <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">color</span> <span class=\"tok-o\">=</span> <span class=\"tok-n\">color</span>\n\n    <span class=\"tok-k\">def</span> <span class=\"tok-nf\">start</span><span class=\"tok-p\">(</span><span class=\"tok-bp\">self</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">t</span><span class=\"tok-p\">):</span>\n        <span class=\"tok-n\">t</span><span class=\"tok-o\">.</span><span class=\"tok-n\">penup</span><span class=\"tok-p\">()</span>\n        <span class=\"tok-n\">t</span><span class=\"tok-o\">.</span><span class=\"tok-n\">goto</span><span class=\"tok-p\">(</span><span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">x</span><span class=\"tok-p\">,</span> <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">y</span><span class=\"tok-p\">)</span>\n        <span class=\"tok-n\">t</span><span class=\"tok-o\">.</span><span class=\"tok-n\">setheading</span><span class=\"tok-p\">(</span><span class=\"tok-mi\">0</span><span class=\"tok-p\">)</span>\n        <span class=\"tok-n\">t</span><span class=\"tok-o\">.</span><span class=\"tok-n\">pendown</span><span class=\"tok-p\">()</span>\n        <span class=\"tok-n\">t</span><span class=\"tok-o\">.</span><span class=\"tok-n\">color</span><span class=\"tok-p\">(</span><span class=\"tok-s2\">&quot;black&quot;</span><span class=\"tok-p\">,</span> <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">color</span><span class=\"tok-p\">)</span>\n\n    <span class=\"tok-k\">def</span> <span class=\"tok-nf\">draw</span><span class=\"tok-p\">(</span><span class=\"tok-bp\">self</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">t</span><span class=\"tok-p\">):</span>\n        <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">start</span><span class=\"tok-p\">(</span><span class=\"tok-n\">t</span><span class=\"tok-p\">)</span>\n        <span class=\"tok-n\">t</span><span class=\"tok-o\">.</span><span class=\"tok-n\">dot</span><span class=\"tok-p\">(</span><span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">size</span><span class=\"tok-p\">,</span> <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">color</span><span class=\"tok-p\">)</span>\n\n\n<span class=\"tok-k\">class</span> <span class=\"tok-nc\">Hexagon</span><span class=\"tok-p\">(</span><span class=\"tok-n\">Shape</span><span class=\"tok-p\">):</span>\n    <span class=\"tok-k\">def</span> <span class=\"tok-fm\">__init__</span><span class=\"tok-p\">(</span><span class=\"tok-bp\">self</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">x</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">y</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">size</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">color</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">label</span><span class=\"tok-o\">=</span><span class=\"tok-s2\">&quot;hex&quot;</span><span class=\"tok-p\">):</span>\n        <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">label</span> <span class=\"tok-o\">=</span> <span class=\"tok-n\">label</span>\n\n    <span class=\"tok-k\">def</span> <span class=\"tok-nf\">draw</span><span class=\"tok-p\">(</span><span class=\"tok-bp\">self</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">t</span><span class=\"tok-p\">):</span>\n        <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">start</span><span class=\"tok-p\">(</span><span class=\"tok-n\">t</span><span class=\"tok-p\">)</span>\n        <span class=\"tok-n\">t</span><span class=\"tok-o\">.</span><span class=\"tok-n\">begin_fill</span><span class=\"tok-p\">()</span>\n        <span class=\"tok-k\">for</span> <span class=\"tok-n\">_</span> <span class=\"tok-ow\">in</span> <span class=\"tok-nb\">range</span><span class=\"tok-p\">(</span><span class=\"tok-mi\">6</span><span class=\"tok-p\">):</span>\n            <span class=\"tok-n\">t</span><span class=\"tok-o\">.</span><span class=\"tok-n\">forward</span><span class=\"tok-p\">(</span><span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">size</span><span class=\"tok-p\">)</span>\n            <span class=\"tok-n\">t</span><span class=\"tok-o\">.</span><span class=\"tok-n\">left</span><span class=\"tok-p\">(</span><span class=\"tok-mi\">60</span><span class=\"tok-p\">)</span>\n        <span class=\"tok-n\">t</span><span class=\"tok-o\">.</span><span class=\"tok-n\">end_fill</span><span class=\"tok-p\">()</span>\n\n\n<span class=\"tok-k\">class</span> <span class=\"tok-nc\">Diamond</span><span class=\"tok-p\">(</span><span class=\"tok-n\">Shape</span><span class=\"tok-p\">):</span>\n    <span class=\"tok-k\">def</span> <span class=\"tok-nf\">drow</span><span class=\"tok-p\">(</span><span class=\"tok-bp\">self</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">t</span><span class=\"tok-p\">):</span>\n        <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">start</span><span class=\"tok-p\">(</span><span class=\"tok-n\">t</span><span class=\"tok-p\">)</span>\n        <span class=\"tok-n\">t</span><span class=\"tok-o\">.</span><span class=\"tok-n\">left</span><span class=\"tok-p\">(</span><span class=\"tok-mi\">45</span><span class=\"tok-p\">)</span>\n        <span class=\"tok-n\">t</span><span class=\"tok-o\">.</span><span class=\"tok-n\">begin_fill</span><span class=\"tok-p\">()</span>\n        <span class=\"tok-k\">for</span> <span class=\"tok-n\">_</span> <span class=\"tok-ow\">in</span> <span class=\"tok-nb\">range</span><span class=\"tok-p\">(</span><span class=\"tok-mi\">4</span><span class=\"tok-p\">):</span>\n            <span class=\"tok-n\">t</span><span class=\"tok-o\">.</span><span class=\"tok-n\">forward</span><span class=\"tok-p\">(</span><span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">size</span><span class=\"tok-p\">)</span>\n            <span class=\"tok-n\">t</span><span class=\"tok-o\">.</span><span class=\"tok-n\">left</span><span class=\"tok-p\">(</span><span class=\"tok-mi\">90</span><span class=\"tok-p\">)</span>\n        <span class=\"tok-n\">t</span><span class=\"tok-o\">.</span><span class=\"tok-n\">end_fill</span><span class=\"tok-p\">()</span>\n\n\n<span class=\"tok-k\">def</span> <span class=\"tok-nf\">draw_party</span><span class=\"tok-p\">(</span><span class=\"tok-n\">shapes</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">t</span><span class=\"tok-p\">):</span>\n    <span class=\"tok-k\">for</span> <span class=\"tok-n\">shape</span> <span class=\"tok-ow\">in</span> <span class=\"tok-n\">shapes</span><span class=\"tok-p\">:</span>\n        <span class=\"tok-n\">shape</span><span class=\"tok-o\">.</span><span class=\"tok-n\">draw</span>\n\n\n<span class=\"tok-k\">def</span> <span class=\"tok-nf\">make_party</span><span class=\"tok-p\">():</span>\n    <span class=\"tok-n\">shapes</span> <span class=\"tok-o\">=</span> <span class=\"tok-p\">[]</span>\n    <span class=\"tok-k\">for</span> <span class=\"tok-n\">i</span> <span class=\"tok-ow\">in</span> <span class=\"tok-nb\">range</span><span class=\"tok-p\">(</span><span class=\"tok-mi\">7</span><span class=\"tok-p\">):</span>\n        <span class=\"tok-n\">x</span> <span class=\"tok-o\">=</span> <span class=\"tok-o\">-</span><span class=\"tok-mi\">330</span> <span class=\"tok-o\">+</span> <span class=\"tok-n\">i</span> <span class=\"tok-o\">*</span> <span class=\"tok-mi\">100</span>\n        <span class=\"tok-k\">if</span> <span class=\"tok-n\">i</span> <span class=\"tok-o\">%</span> <span class=\"tok-mi\">2</span> <span class=\"tok-o\">==</span> <span class=\"tok-mi\">0</span><span class=\"tok-p\">:</span>\n            <span class=\"tok-n\">shapes</span><span class=\"tok-o\">.</span><span class=\"tok-n\">append</span><span class=\"tok-p\">(</span><span class=\"tok-n\">Hexagon</span><span class=\"tok-p\">(</span><span class=\"tok-n\">x</span><span class=\"tok-p\">,</span> <span class=\"tok-mi\">40</span><span class=\"tok-p\">,</span> <span class=\"tok-mi\">40</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">PALETTE</span><span class=\"tok-p\">[</span><span class=\"tok-n\">i</span><span class=\"tok-p\">]))</span>\n        <span class=\"tok-k\">else</span><span class=\"tok-p\">:</span>\n            <span class=\"tok-n\">shapes</span><span class=\"tok-o\">.</span><span class=\"tok-n\">append</span><span class=\"tok-p\">(</span><span class=\"tok-n\">Diamond</span><span class=\"tok-p\">(</span><span class=\"tok-n\">x</span> <span class=\"tok-o\">+</span> <span class=\"tok-mi\">30</span><span class=\"tok-p\">,</span> <span class=\"tok-o\">-</span><span class=\"tok-mi\">80</span><span class=\"tok-p\">,</span> <span class=\"tok-mi\">55</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">PALETTE</span><span class=\"tok-p\">[</span><span class=\"tok-n\">i</span><span class=\"tok-p\">]))</span>\n    <span class=\"tok-k\">return</span> <span class=\"tok-n\">shapes</span>\n\n\n<span class=\"tok-k\">if</span> <span class=\"tok-vm\">__name__</span> <span class=\"tok-o\">==</span> <span class=\"tok-s2\">&quot;__main__&quot;</span><span class=\"tok-p\">:</span>\n    <span class=\"tok-n\">screen</span> <span class=\"tok-o\">=</span> <span class=\"tok-n\">turtle</span><span class=\"tok-o\">.</span><span class=\"tok-n\">Screen</span><span class=\"tok-p\">()</span>\n    <span class=\"tok-n\">screen</span><span class=\"tok-o\">.</span><span class=\"tok-n\">title</span><span class=\"tok-p\">(</span><span class=\"tok-s2\">&quot;Shape Party&quot;</span><span class=\"tok-p\">)</span>\n    <span class=\"tok-n\">screen</span><span class=\"tok-o\">.</span><span class=\"tok-n\">tracer</span><span class=\"tok-p\">(</span><span class=\"tok-mi\">0</span><span class=\"tok-p\">)</span>\n    <span class=\"tok-n\">pen</span> <span class=\"tok-o\">=</span> <span class=\"tok-n\">turtle</span><span class=\"tok-o\">.</span><span class=\"tok-n\">Turtle</span><span class=\"tok-p\">()</span>\n    <span class=\"tok-n\">pen</span><span class=\"tok-o\">.</span><span class=\"tok-n\">hideturtle</span><span class=\"tok-p\">()</span>\n    <span class=\"tok-n\">pen</span><span class=\"tok-o\">.</span><span class=\"tok-n\">pensize</span><span class=\"tok-p\">(</span><span class=\"tok-mi\">2</span><span class=\"tok-p\">)</span>\n    <span class=\"tok-n\">draw_party</span><span class=\"tok-p\">(</span><span class=\"tok-n\">make_party</span><span class=\"tok-p\">(),</span> <span class=\"tok-n\">pen</span><span class=\"tok-p\">)</span>\n    <span class=\"tok-n\">screen</span><span class=\"tok-o\">.</span><span class=\"tok-n\">update</span><span class=\"tok-p\">()</span>\n    <span class=\"tok-n\">turtle</span><span class=\"tok-o\">.</span><span class=\"tok-n\">done</span><span class=\"tok-p\">()</span>"
