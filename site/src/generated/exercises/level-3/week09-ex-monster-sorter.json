p\">()</span>\n    <span class=\"tok-n\">draw_axes</span><span class=\"tok-p\">(</span><span class=\"tok-n\">pen</span><span class=\"tok-p\">)</span>\n    <span class=\"tok-k\">for</span> <span class=\"tok-n\">m</span> <span class=\"tok-ow\">in</span> <span class=\"tok-n\">MYSTERY</span><span class=\"tok-p\">:</span>\n        <span class=\"tok-n\">draw_link</span><span class=\"tok-p\">(</span><span class=\"tok-n\">pen</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">TRAINING</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">m</span><span class=\"tok-p\">)</span>     <span class=\"tok-c1\"># lines first, so the cards sit on top</span>\n    <span class=\"tok-k\">for</span> <span class=\"tok-n\">card</span> <span class=\"tok-ow\">in</span> <span class=\"tok-n\">TRAINING</span><span class=\"tok-p\">:</span>\n        <span class=\"tok-n\">draw_card</span><span class=\"tok-p\">(</span><span class=\"tok-n\">pen</span><span class=\"tok-p\">,</span> <span class=\"tok-o\">*</span><span class=\"tok-n\">card</span><span class=\"tok-p\">)</span>\n    <span class=\"tok-k\">for</span> <span class=\"tok-n\">m</span> <span class=\"tok-ow\">in</span> <span class=\"tok-n\">MYSTERY</span><span class=\"tok-p\">:</span>\n        <span class=\"tok-n\">draw_mystery</span><span class=\"tok-p\">(</span><span class=\"tok-n\">pen</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">TRAINING</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">m</span><span class=\"tok-p\">)</span>\n    <span class=\"tok-n\">screen</span><span class=\"tok-o\">.</span><span class=\"tok-n\">update</span><span class=\"tok-p\">()</span>\n    <span class=\"tok-n\">turtle</span><span class=\"tok-o\">.</span><span class=\"tok-n\">done</span><span class=\"tok-p\">()</span>"
