 "starter": {
  "name": "starter.py",
  "raw": "# Monster sorter\n# A tiny \"machine learning\" program: a NEAREST-NEIGHBOR classifier.\n# Each monster card has two FEATURES we can measure:\n#   fluff (0-10): how fluffy it is      teeth (0-10): how many sharp teeth\n# and a LABEL a person gave it: \"friendly\" or \"grumpy\".\n# To guess the label of a new (mystery) monster, find the training card that\n# is CLOSEST to it and copy that card's label. No rules written by hand!\n\nimport math\nimport turtle\n\n# (fluff, teeth, label) - made-up training cards\nTRAINING = [\n    (9, 1, \"friendly\"), (8, 2, \"friendly\"), (7, 3, \"friendly\"),\n    (6, 1, \"friendly\"), (8, 4, \"friendly\"),\n    (2, 9, \"grumpy\"), (3, 8, \"grumpy\"), (1, 7, \"grumpy\"),\n    (4, 9, \"grumpy\"), (2, 6, \"grumpy\"),\n]\nMYSTERY = [(5, 2), (3, 6), (5, 5)]\n\nSCALE = 36            # pixels per point on the chart\nORIGIN = (-180, -180)  # where (0, 0) goes on the screen\n\n\ndef distance(a, b):\n    \"\"\"Straight-line distance between two cards, using their first two\n    numbers (fluff, teeth). Pythagoras: sqrt(dx*dx + dy*dy).\"\"\"\n    # TODO 1: work out dx (the difference in fluff) and dy (the\n    #         difference in teeth), then return math.sqrt(dx * dx + dy * dy)\n    return 0\n\n\ndef nearest(training, mystery):\n    \"\"\"The training card closest to the mystery monster.\"\"\"\n    best = training[0]\n    # TODO 2: loop over every card in training. If the card is closer to\n    #         the mystery than best is, the card becomes the new best.\n    return best\n\n\ndef classify(training, mystery):\n    \"\"\"Guess the label: copy the label of the nearest card.\"\"\"\n    return nearest(training, mystery)[2]\n\n\n# ---------------------------------------------------------------- drawing\ndef to_screen(fluff, teeth):\n    return ORIGIN[0] + fluff * SCALE, ORIGIN[1] + teeth * SCALE\n\n\ndef draw_axes(t):\n    x0, y0 = to_screen(0, 0)\n    x1, y1 = to_screen(10, 10)\n    t.penup(); t.goto(x0, y0); t.pendown(); t.goto(x1, y0)\n    t.penup(); t.goto(x0, y0); t.pendown(); t.goto(x0, y1)\n    t.penup(); t.goto(x1 - 40, y0 - 30)\n    t.write(\"fluff ->\", align=\"center\", font=(\"Arial\", 12, \"normal\"))\n    t.goto(x0 - 10, y1 + 10)\n    t.write(\"teeth\", align=\"center\", font=(\"Arial\", 12, \"normal\"))\n\n\ndef draw_card(t, fluff, teeth, label):\n    \"\"\"Friendly = orange circle with F, grumpy = blue square with G.\"\"\"\n    x, y = to_screen(fluff, teeth)\n    t.penup()\n    if label == \"friendly\":\n        t.goto(x, y - 12)\n        t.fillcolor(\"#E69F00\")\n        t.pendown(); t.begin_fill(); t.circle(12); t.end_fill()\n        letter = \"F\"\n    else:\n        t.goto(x - 11, y - 11)\n        t.setheading(0)\n        t.fillcolor(\"#56B4E9\")\n        t.pendown(); t.begin_fill()\n        for _ in range(4):\n            t.forward(22); t.left(90)\n        t.end_fill()\n        letter = \"G\"\n    t.penup(); t.goto(x, y - 8)\n    t.write(letter, align=\"center\", font=(\"Arial\", 11, \"bold\"))\n\n\ndef draw_link(t, training, mystery):\n    \"\"\"A line from the mystery monster to its nearest neighbor.\"\"\"\n    near = nearest(training, mystery)\n    t.penup(); t.goto(*to_screen(*mystery)); t.pendown()\n    t.pensize(2)\n    t.goto(*to_screen(near[0], near[1]))\n    t.pensize(1)\n\n\ndef draw_mystery(t, training, mystery):\n    \"\"\"A white circle with '?', and the guess written above it.\"\"\"\n    x, y = to_screen(*mystery)\n    t.penup(); t.goto(x, y - 12)\n    t.fillcolor(\"white\")\n    t.pendown(); t.begin_fill(); t.circle(12); t.end_fill()\n    t.penup(); t.goto(x, y - 9)\n    t.write(\"?\", align=\"center\", font=(\"Arial\", 13, \"bold\"))\n    t.goto(x, y + 14)\n    t.write(\"guess: \" + classify(training, mystery), align=\"center\", font=(\"Arial\", 10, \"normal\"))\n\n\nif __name__ == \"__main__\":\n    for m in MYSTERY:\n        print(m, \"->\", classify(TRAINING, m))\n    screen = turtle.Screen()\n    screen.title(\"Monster sorter: nearest neighbor\")\n    screen.tracer(0)\n    pen = turtle.Turtle()\n    pen.hideturtle()\n    draw_axes(pen)\n    for m in MYSTERY:\n        draw_link(pen, TRAINING, m)     # lines first, so the cards sit on top\n    for card in TRAINING:\n        draw_card(pen, *card)\n    for m in MYSTERY:\n        draw_mystery(pen, TRAINING, m)\n    screen.update()\n    turtle.done()\n",
  "html": "<span class=\"tok-c1\"># Monster sorter</span>\n<span class=\"tok-c1\"># A tiny &quot;machine learning&quot; program: a NEAREST-NEIGHBOR classifier.</span>\n<span class=\"tok-c1\"># Each monster card has two FEATURES we can measure:</span>\n<span class=\"tok-c1\">#   fluff (0-10): how fluffy it is      teeth (0-10): how many sharp teeth</span>\n<span class=\"tok-c1\"># and a LABEL a person gave it: &quot;friendly&quot; or &quot;grumpy&quot;.</span>\n<span class=\"tok-c1\"># To guess the label of a new (mystery) monster, find the training card that</span>\n<span class=\"tok-c1\"># is CLOSEST to it and copy that card&#39;s label. No rules written by hand!</span>\n\n<span class=\"tok-kn\">import</span> <span class=\"tok-nn\">math</span>\n<span class=\"tok-kn\">import</span> <span class=\"tok-nn\">turtle</span>\n\n<span class=\"tok-c1\"># (fluff, teeth, label) - made-up training cards</span>\n<span class=\"tok-n\">TRAINING</span> <span class=\"tok-o\">=</span> <span class=\"tok-p\">[</span>\n    <span class=\"tok-p\">(</span><span class=\"tok-mi\">9</span><span class=\"tok-p\">,</span> <span class=\"tok-mi\">1</span><span class=\"tok-p\">,</span> <span class=\"tok-s2\">&quot;friendly&quot;</span><span class=\"tok-p\">),</span> <span class=\"tok-p\">(</span><span class=\"tok-mi\">8</span><span class=\"tok-p\">,</span> <span class=\"tok-mi\">2</span><span class=\"tok-p\">,</span> <span class=\"tok-s2\">&quot;friendly&quot;</span><span class=\"tok-p\">),</span> <span class=\"tok-p\">(</span><span class=\"tok-mi\">7</span><span class=\"tok-p\">,</span> <span class=\"tok-mi\">3</span><span class=\"tok-p\">,</span> <span class=\"tok-s2\">&quot;friendly&quot;</span><span class=\"tok-p\">),</span>\n    <span class=\"tok-p\">(</span><span class=\"tok-mi\">6</span><span class=\"tok-p\">,</span> <span class=\"tok-mi\">1</span><span class=\"tok-p\">,</span> <span class=\"tok-s2\">&quot;friendly&quot;</span><span class=\"tok-p\">),</span> <span class=\"tok-p\">(</span><span class=\"tok-mi\">8</span><span class=\"tok-p\">,</span> <span class=\"tok-mi\">4</span><span class=\"tok-p\">,</span> <span class=\"tok-s2\">&quot;friendly&quot;</span><span class=\"tok-p\">),</span>\n    <span class=\"tok-p\">(</span><span class=\"tok-mi\">2</span><span class=\"tok-p\">,</span> <span class=\"tok-mi\">9</span><span class=\"tok-p\">,</span> <span class=\"tok-s2\">&quot;grumpy&quot;</span><span class=\"tok-p\">),</span> <span class=\"tok-p\">(</span><span class=\"tok-mi\">3</span><span class=\"tok-p\">,</span> <span class=\"tok-mi\">8</span><span class=\"tok-p\">,</span> <span class=\"tok-s2\">&quot;grumpy&quot;</span><span class=\"tok-p\">),</span> <span class=\"tok-p\">(</span><span class=\"tok-mi\">1</span><span class=\"tok-p\">,</span> <span class=\"tok-mi\">7</span><span class=\"tok-p\">,</span> <span class=\"tok-s2\">&quot;grumpy&quot;</span><span class=\"tok-p\">),</span>\n    <span class=\"tok-p\">(</span><span class=\"tok-mi\">4</span><span class=\"tok-p\">,</span> <span class=\"tok-mi\">9</span><span class=\"tok-p\">,</span> <span class=\"tok-s2\">&quot;grumpy&quot;</span><span class=\"tok-p\">),</span> <span class=\"tok-p\">(</span><span class=\"tok-mi\">2</span><span class=\"tok-p\">,</span> <span class=\"tok-mi\">6</span><span class=\"tok-p\">,</span> <span class=\"tok-s2\">&quot;grumpy&quot;</span><span class=\"tok-p\">),</span>\n<span class=\"tok-p\">]</span>\n<span class=\"tok-n\">MYSTERY</span> <span class=\"tok-o\">=</span> <span class=\"tok-p\">[(</span><span class=\"tok-mi\">5</span><span class=\"tok-p\">,</span> <span class=\"tok-mi\">2</span><span class=\"tok-p\">),</span> <span class=\"tok-p\">(</span><span class=\"tok-mi\">3</span><span class=\"tok-p\">,</span> <span class=\"tok-mi\">6</span><span class=\"tok-p\">),</span> <span class=\"tok-p\">(</span><span class=\"tok-mi\">5</span><span class=\"tok-p\">,</span> <span class=\"tok-mi\">5</span><span class=\"tok-p\">)]</span>\n\n<span class=\"tok-n\">SCALE</span> <span class=\"tok-o\">=</span> <span class=\"tok-mi\">36</span>            <span class=\"tok-c1\"># pixels per point on the chart</span>\n<span class=\"tok-n\">ORIGIN</span> <span class=\"tok-o\">=</span> <span class=\"tok-p\">(</span><span class=\"tok-o\">-</span><span class=\"tok-mi\">180</span><span class=\"tok-p\">,</span> <span class=\"tok-o\">-</span><span class=\"tok-mi\">180</span><span class=\"tok-p\">)</span>  <span class=\"tok-c1\"># where (0, 0) goes on the screen</span>\n\n\n<span class=\"tok-k\">def</span> <span class=\"tok-nf\">distance</span><span class=\"tok-p\">(</span><span class=\"tok-n\">a</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">b</span><span class=\"tok-p\">):</span>\n<span class=\"tok-w\">    </span><span class=\"tok-sd\">&quot;&quot;&quot;Straight-line distance between two cards, using their first two</span>\n<span class=\"tok-sd\">    numbers (fluff, teeth). Pythagoras: sqrt(dx*dx + dy*dy).&quot;&quot;&quot;</span>\n    <span class=\"tok-c1\"># TODO 1: work out dx (the difference in fluff) and dy (the</span>\n    <span class=\"tok-c1\">#         difference in teeth), then return math.sqrt(dx * dx + dy * dy)</span>\n    <span class=\"tok-k\">return</span> <span class=\"tok-mi\">0</span>\n\n\n<span class=\"tok-k\">def</span> <span class=\"tok-nf\">nearest</span><span class=\"tok-p\">(</span><span class=\"tok-n\">training</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">mystery</span><span class=\"tok-p\">):</span>\n<span class=\"tok-w\">    </span><span class=\"tok-sd\">&quot;&quot;&quot;The training card closest to the mystery monster.&quot;&quot;&quot;</span>\n    <span class=\"tok-n\">best</span> <span class=\"tok-o\">=</span> <span class=\"tok-n\">training</span><span class=\"tok-p\">[</span><span class=\"tok-mi\">0</span><span class=\"tok-p\">]</span>\n    <span class=\"tok-c1\"># TODO 2: loop over every card in training. If the card is closer to</span>\n    <span class=\"tok-c1\">#         the mystery than best is, the card becomes the new best.</span>\n    <span class=\"tok-k\">return</span> <span class=\"tok-n\">best</span>\n\n\n<span class=\"tok-k\">def</span> <span class=\"tok-nf\">classify</span><span class=\"tok-p\">(</span><span class=\"tok-n\">training</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">mystery</span><span class=\"tok-p\">):</span>\n<span class=\"tok-w\">    </span><span class=\"tok-sd\">&quot;&quot;&quot;Guess the label: copy the label of the nearest card.&quot;&quot;&quot;</span>\n    <span class=\"tok-k\">return</span> <span class=\"tok-n\">nearest</span><span class=\"tok-p\">(</span><span class=\"tok-n\">training</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">mystery</span><span class=\"tok-p\">)[</span><span class=\"tok-mi\">2</span><span class=\"tok-p\">]</span>\n\n\n<span class=\"tok-c1\"># ---------------------------------------------------------------- drawing</span>\n<span class=\"tok-k\">def</span> <span class=\"tok-nf\">to_screen</span><span class=\"tok-p\">(</span><span class=\"tok-n\">fluff</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">teeth</span><span class=\"tok-p\">):</span>\n    <span class=\"tok-k\">return</span> <span class=\"tok-n\">ORIGIN</span><span class=\"tok-p\">[</span><span class=\"tok-mi\">0</span><span class=\"tok-p\">]</span> <span class=\"tok-o\">+</span> <span class=\"tok-n\">fluff</span> <span class=\"tok-o\">*</span> <span class=\"tok-n\">SCALE</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">ORIGIN</span><span class=\"tok-p\">[</span><span class=\"tok-mi\">1</span><span class=\"tok-p\">]</span> <span class=\"tok-o\">+</span> <span class=\"tok-n\">teeth</span> <span class=\"tok-o\">*</span> <span class=\"tok-n\">SCALE</span>\n\n\n<span class=\"tok-k\">def</span> <span class=\"tok-nf\">draw_axes</span><span class=\"tok-p\">(</span><span class=\"tok-n\">t</span><span class=\"tok-p\">):</span>\n    <span class=\"tok-n\">x0</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">y0</span> <span class=\"tok-o\">=</span> <span class=\"tok-n\">to_screen</span><span class=\"tok-p\">(</span><span class=\"tok-mi\">0</span><span class=\"tok-p\">,</span> <span class=\"tok-mi\">0</span><span class=\"tok-p\">)</span>\n    <span class=\"tok-n\">x1</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">y1</span> <span class=\"tok-o\">=</span> <span class=\"tok-n\">to_screen</span><span class=\"tok-p\">(</span><span class=\"tok-mi\">10</span><span class=\"tok-p\">,</span> <span class=\"tok-mi\">10</span><span class=\"tok-p\">)</span>\n    <span class=\"tok-n\">t</span><span class=\"tok-o\">.</span><span class=\"tok-n\">penup</span><span class=\"tok-p\">();</span> <span class=\"tok-n\">t</span><span class=\"tok-o\">.</span><span class=\"tok-n\">goto</span><span class=\"tok-p\">(</span><span class=\"tok-n\">x0</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">y0</span><span class=\"tok-p\">);</span> <span class=\"tok-n\">t</span><span class=\"tok-o\">.</span><span class=\"tok-n\">pendown</span><span class=\"tok-p\">();</span> <span class=\"tok-n\">t</span><span class=\"tok-o\">.</span><span class=\"tok-n\">goto</span><span class=\"tok-p\">(</span><span class=\"tok-n\">x1</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">y0</span><span class=\"tok-p\">)</span>\n    <span class=\"tok-n\">t</span><span class=\"tok-o\">.</span><span class=\"tok-n\">penup</span><span class=\"tok-p\">();</span> <span class=\"tok-n\">t</span><span class=\"tok-o\">.</span><span class=\"tok-n\">goto</span><span class=\"tok-p\">(</span><span class=\"tok-n\">x0</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">y0</span><span class=\"tok-p\">);</span> <span class=\"tok-n\">t</span><span class=\"tok-o\">.</span><span class=\"tok-n\">pendown</span><span class=\"tok-p\">();</span> <span class=\"tok-n\">t</span><span class=\"tok-o\">.</span><span class=\"tok-n\">goto</span><span class=\"tok-p\">(</span><span class=\"tok-n\">x0</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">y1</span><span class=\"tok-p\">)</span>\n    <span class=\"tok-n\">t</span><span class=\"tok-o\">.</span><span class=\"tok-n\">penup</span><span class=\"tok-p\">();</span> <span class=\"tok-n\">t</span><span class=\"tok-o\">.</span><span class=\"tok-n\">goto</span><span class=\"tok-p\">(</span><span class=\"tok-n\">x1</span> <span class=\"tok-o\">-</span> <span class=\"tok-mi\">40</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">y0</span> <span class=\"tok-o\">-</span> <span class=\"tok-mi\">30</span><span class=\"tok-p\">)</span>\n    <span class=\"tok-n\">t</span><span class=\"tok-o\">.</span><span class=\"tok-n\">write</span><span class=\"tok-p\">(</span><span class=\"tok-s2\">&quot;fluff -&gt;&quot;</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">align</span><span class=\"tok-o\">=</span><span class=\"tok-s2\">&quot;center&quot;</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">font</span><span class=\"tok-o\">=</span><span class=\"tok-p\">(</span><span class=\"tok-s2\">&quot;Arial&quot;</span><span class=\"tok-p\">,</span> <span class=\"tok-mi\">12</span><span class=\"tok-p\">,</span> <span class=\"tok-s2\">&quot;normal&quot;</span><span class=\"tok-p\">))</span>\n    <span class=\"tok-n\">t</span><span class=\"tok-o\">.</span><span class=\"tok-n\">goto</span><span class=\"tok-p\">(</span><span class=\"tok-n\">x0</span> <span class=\"tok-o\">-</span> <span class=\"tok-mi\">10</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">y1</span> <span class=\"tok-o\">+</span> <span class=\"tok-mi\">10</span><span class=\"tok-p\">)</span>\n    <span class=\"tok-n\">t</span><span class=\"tok-o\">.</span><span class=\"tok-n\">write</span><span class=\"tok-p\">(</span><span class=\"tok-s2\">&quot;teeth&quot;</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">align</span><span class=\"tok-o\">=</span><span class=\"tok-s2\">&quot;center&quot;</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">font</span><span class=\"tok-o\">=</span><span class=\"tok-p\">(</span><span class=\"tok-s2\">&quot;Arial&quot;</span><span class=\"tok-p\">,</span> <span class=\"tok-mi\">12</span><span class=\"tok-p\">,</span> <span class=\"tok-s2\">&quot;normal&quot;</span><span class=\"tok-p\">))</span>\n\n\n<span class=\"tok-k\">def</span> <span class=\"tok-nf\">draw_card</span><span class=\"tok-p\">(</span><span class=\"tok-n\">t</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">fluff</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">teeth</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">label</span><span class=\"tok-p\">):</span>\n<span class=\"tok-w\">    </span><span class=\"tok-sd\">&quot;&quot;&quot;Friendly = orange circle with F, grumpy = blue square with G.&quot;&quot;&quot;</span>\n    <span class=\"tok-n\">x</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">y</span> <span class=\"tok-o\">=</span> <span class=\"tok-n\">to_screen</span><span class=\"tok-p\">(</span><span class=\"tok-n\">fluff</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">teeth</span><span class=\"tok-p\">)</span>\n    <span class=\"tok-n\">t</span><span class=\"tok-o\">.</span><span class=\"tok-n\">penup</span><span class=\"tok-p\">()</span>\n    <span class=\"tok-k\">if</span> <span class=\"tok-n\">label</span> <span class=\"tok-o\">==</span> <span class=\"tok-s2\">&quot;friendly&quot;</span><span class=\"tok-p\">:</span>\n        <span class=\"tok-n\">t</span><span class=\"tok-o\">.</span><span class=\"tok-n\">goto</span><span class=\"tok-p\">(</span><span class=\"tok-n\">x</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">y</span> <span class=\"tok-o\">-</span> <span class=\"tok-mi\">12</span><span class=\"tok-p\">)</span>\n        <span class=\"tok-n\">t</span><span class=\"tok-o\">.</span><span class=\"tok-n\">fillcolor</span><span class=\"tok-p\">(</span><span class=\"tok-s2\">&quot;#E69F00&quot;</span><span class=\"tok-p\">)</span>\n        