  "name": "starter.py",
  "raw": "# Undo Paint - YOUR version\n# A drawing program where every stroke is pushed onto a STACK.\n# Press u to undo: pop the last stroke off the stack and redraw the rest.\n# Keys: arrows draw, c changes color, u undoes.\n# Finish the Stack TODOs, then press Run and see if it does what the README says.\n\nimport turtle\n\nPALETTE = [\"#0072B2\", \"#D55E00\", \"#009E73\", \"#CC79A7\", \"#E69F00\", \"#000000\"]\nCOLOR_NAMES = [\"blue\", \"vermillion\", \"green\", \"purple\", \"orange\", \"black\"]\nSTEP = 30\n\n\nclass Stack:\n    \"\"\"Last in, first out - like a stack of plates.\"\"\"\n\n    def __init__(self):\n        self.items = []\n\n    def push(self, item):\n        \"\"\"Put an item on top.\"\"\"\n        # TODO 1: add item to the END of self.items (the end is the top)\n        pass\n\n    def pop(self):\n        \"\"\"Take the top item off and return it (None if the stack is empty).\"\"\"\n        # TODO 2: if the stack is empty return None,\n        #         otherwise return self.items.pop()\n        return None\n\n    def peek(self):\n        \"\"\"Look at the top item without taking it off (None if empty).\"\"\"\n        # TODO 3: if empty return None, otherwise return the LAST item, self.items[-1]\n        return None\n\n    def is_empty(self):\n        return len(self.items) == 0\n\n    def size(self):\n        # TODO 4: return how many items are on the stack\n        return 0\n\n\nclass Painter:\n    \"\"\"Draws strokes with a turtle and remembers them on a Stack.\"\"\"\n\n    def __init__(self, pen):\n        self.pen = pen\n        self.history = Stack()\n        self.color_index = 0\n        self.x = 0\n        self.y = 0\n\n    def color(self):\n        return PALETTE[self.color_index]\n\n    def next_color(self):\n        self.color_index = (self.color_index + 1) % len(PALETTE)\n\n    def draw_stroke(self, stroke):\n        start, end, color = stroke\n        self.pen.penup()\n        self.pen.goto(start)\n        self.pen.pendown()\n        self.pen.color(color)\n        self.pen.goto(end)\n\n    def move(self, dx, dy):\n        \"\"\"Draw one stroke and push it onto the history stack.\"\"\"\n        start = (self.x, self.y)\n        end = (self.x + dx, self.y + dy)\n        stroke = (start, end, self.color())\n        self.history.push(stroke)\n        self.x, self.y = end\n        self.draw_stroke(stroke)\n\n    def undo(self):\n        \"\"\"Pop the last stroke and redraw everything that is left.\"\"\"\n        stroke = self.history.pop()\n        if stroke is None:\n            return  # nothing to undo\n        self.x, self.y = stroke[0]  # go back to where that stroke started\n        self.pen.clear()\n        for old_stroke in self.history.items:\n            self.draw_stroke(old_stroke)\n        self.pen.penup()\n        self.pen.goto(self.x, self.y)\n\n    # Small methods with no inputs, so we can give them to screen.onkey\n    def up(self):\n        self.move(0, STEP)\n\n    def down(self):\n        self.move(0, -STEP)\n\n    def left(self):\n        self.move(-STEP, 0)\n\n    def right(self):\n        self.move(STEP, 0)\n\n\ndef show_help(writer, painter):\n    \"\"\"Write the keys and the color NAME (so color is never the only clue).\"\"\"\n    writer.clear()\n    writer.penup()\n    writer.goto(-380, 260)\n    name = COLOR_NAMES[painter.color_index]\n    writer.write(f\"Arrows: draw   c: color ({name})   u: undo   strokes: {painter.history.size()}\",\n                 font=(\"Arial\", 14, \"normal\"))\n\n\nif __name__ == \"__main__\":\n    screen = turtle.Screen()\n    screen.title(\"Undo Paint\")\n    pen = turtle.Turtle()\n    pen.shape(\"circle\")\n    pen.shapesize(0.5)\n    pen.pensize(5)\n    pen.speed(0)\n    writer = turtle.Turtle()\n    writer.hideturtle()\n    painter = Painter(pen)\n\n    def key(action):\n        \"\"\"Wrap an action so the help line updates after every key.\"\"\"\n        def handler():\n            action()\n            show_help(writer, painter)\n        return handler\n\n    screen.onkey(key(painter.up), \"Up\")\n    screen.onkey(key(painter.down), \"Down\")\n    screen.onkey(key(painter.left), \"Left\")\n    screen.onkey(key(painter.right), \"Right\")\n    screen.onkey(key(painter.next_color), \"c\")\n    screen.onkey(key(painter.undo), \"u\")\n    screen.listen()\n    show_help(writer, painter)\n    turtle.done()\n",
  "html": "<span class=\"tok-c1\"># Undo Paint - YOUR version</span>\n<span class=\"tok-c1\"># A drawing program where every stroke is pushed onto a STACK.</span>\n<span class=\"tok-c1\"># Press u to undo: pop the last stroke off the stack and redraw the rest.</span>\n<span class=\"tok-c1\"># Keys: arrows draw, c changes color, u undoes.</span>\n<span class=\"tok-c1\"># Finish the Stack TODOs, then press Run and see if it does what the README says.</span>\n\n<span class=\"tok-kn\">import</span> <span class=\"tok-nn\">turtle</span>\n\n<span class=\"tok-n\">PALETTE</span> <span class=\"tok-o\">=</span> <span class=\"tok-p\">[</span><span class=\"tok-s2\">&quot;#0072B2&quot;</span><span class=\"tok-p\">,</span> <span class=\"tok-s2\">&quot;#D55E00&quot;</span><span class=\"tok-p\">,</span> <span class=\"tok-s2\">&quot;#009E73&quot;</span><span class=\"tok-p\">,</span> <span class=\"tok-s2\">&quot;#CC79A7&quot;</span><span class=\"tok-p\">,</span> <span class=\"tok-s2\">&quot;#E69F00&quot;</span><span class=\"tok-p\">,</span> <span class=\"tok-s2\">&quot;#000000&quot;</span><span class=\"tok-p\">]</span>\n<span class=\"tok-n\">COLOR_NAMES</span> <span class=\"tok-o\">=</span> <span class=\"tok-p\">[</span><span class=\"tok-s2\">&quot;blue&quot;</span><span class=\"tok-p\">,</span> <span class=\"tok-s2\">&quot;vermillion&quot;</span><span class=\"tok-p\">,</span> <span class=\"tok-s2\">&quot;green&quot;</span><span class=\"tok-p\">,</span> <span class=\"tok-s2\">&quot;purple&quot;</span><span class=\"tok-p\">,</span> <span class=\"tok-s2\">&quot;orange&quot;</span><span class=\"tok-p\">,</span> <span class=\"tok-s2\">&quot;black&quot;</span><span class=\"tok-p\">]</span>\n<span class=\"tok-n\">STEP</span> <span class=\"tok-o\">=</span> <span class=\"tok-mi\">30</span>\n\n\n<span class=\"tok-k\">class</span> <span class=\"tok-nc\">Stack</span><span class=\"tok-p\">:</span>\n<span class=\"tok-w\">    </span><span class=\"tok-sd\">&quot;&quot;&quot;Last in, first out - like a stack of plates.&quot;&quot;&quot;</span>\n\n    <span class=\"tok-k\">def</span> <span class=\"tok-fm\">__init__</span><span class=\"tok-p\">(</span><span class=\"tok-bp\">self</span><span class=\"tok-p\">):</span>\n        <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">items</span> <span class=\"tok-o\">=</span> <span class=\"tok-p\">[]</span>\n\n    <span class=\"tok-k\">def</span> <span class=\"tok-nf\">push</span><span class=\"tok-p\">(</span><span class=\"tok-bp\">self</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">item</span><span class=\"tok-p\">):</span>\n<span class=\"tok-w\">        </span><span class=\"tok-sd\">&quot;&quot;&quot;Put an item on top.&quot;&quot;&quot;</span>\n        <span class=\"tok-c1\"># TODO 1: add item to the END of self.items (the end is the top)</span>\n        <span class=\"tok-k\">pass</span>\n\n    <span class=\"tok-k\">def</span> <span class=\"tok-nf\">pop</span><span class=\"tok-p\">(</span><span class=\"tok-bp\">self</span><span class=\"tok-p\">):</span>\n<span class=\"tok-w\">        </span><span class=\"tok-sd\">&quot;&quot;&quot;Take the top item off and return it (None if the stack is empty).&quot;&quot;&quot;</span>\n        <span class=\"tok-c1\"># TODO 2: if the stack is empty return None,</span>\n        <span class=\"tok-c1\">#         otherwise return self.items.pop()</span>\n        <span class=\"tok-k\">return</span> <span class=\"tok-kc\">None</span>\n\n    <span class=\"tok-k\">def</span> <span class=\"tok-nf\">peek</span><span class=\"tok-p\">(</span><span class=\"tok-bp\">self</span><span class=\"tok-p\">):</span>\n<span class=\"tok-w\">        </span><span class=\"tok-sd\">&quot;&quot;&quot;Look at the top item without taking it off (None if empty).&quot;&quot;&quot;</span>\n        <span class=\"tok-c1\"># TODO 3: if empty return None, otherwise return the LAST item, self.items[-1]</span>\n        <span class=\"tok-k\">return</span> <span class=\"tok-kc\">None</span>\n\n    <span class=\"tok-k\">def</span> <span class=\"tok-nf\">is_empty</span><span class=\"tok-p\">(</span><span class=\"tok-bp\">self</span><span class=\"tok-p\">):</span>\n        <span class=\"tok-k\">return</span> <span class=\"tok-nb\">len</span><span class=\"tok-p\">(</span><span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">items</span><span class=\"tok-p\">)</span> <span class=\"tok-o\">==</span> <span class=\"tok-mi\">0</span>\n\n    <span class=\"tok-k\">def</span> <span class=\"tok-nf\">size</span><span class=\"tok-p\">(</span><span class=\"tok-bp\">self</span><span class=\"tok-p\">):</span>\n        <span class=\"tok-c1\"># TODO 4: return how many items are on the stack</span>\n        <span class=\"tok-k\">return</span> <span class=\"tok-mi\">0</span>\n\n\n<span class=\"tok-k\">class</span> <span class=\"tok-nc\">Painter</span><span class=\"tok-p\">:</span>\n<span class=\"tok-w\">    </span><span class=\"tok-sd\">&quot;&quot;&quot;Draws strokes with a turtle and remembers them on a Stack.&quot;&quot;&quot;</span>\n\n    <span class=\"tok-k\">def</span> <span class=\"tok-fm\">__init__</span><span class=\"tok-p\">(</span><span class=\"tok-bp\">self</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">pen</span><span class=\"tok-p\">):</span>\n        <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">pen</span> <span class=\"tok-o\">=</span> <span class=\"tok-n\">pen</span>\n        <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">history</span> <span class=\"tok-o\">=</span> <span class=\"tok-n\">Stack</span><span class=\"tok-p\">()</span>\n        <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">color_index</span> <span class=\"tok-o\">=</span> <span class=\"tok-mi\">0</span>\n        <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">x</span> <span class=\"tok-o\">=</span> <span class=\"tok-mi\">0</span>\n        <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">y</span> <span class=\"tok-o\">=</span> <span class=\"tok-mi\">0</span>\n\n    <span class=\"tok-k\">def</span> <span class=\"tok-nf\">color</span><span class=\"tok-p\">(</span><span class=\"tok-bp\">self</span><span class=\"tok-p\">):</span>\n        <span class=\"tok-k\">return</span> <span class=\"tok-n\">PALETTE</span><span class=\"tok-p\">[</span><span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">color_index</span><span class=\"tok-p\">]</span>\n\n    <span class=\"tok-k\">def</span> <span class=\"tok-nf\">next_color</span><span class=\"tok-p\">(</span><span class=\"tok-bp\">self</span><span class=\"tok-p\">):</span>\n        <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">color_index</span> <span class=\"tok-o\">=</span> <span class=\"tok-p\">(</span><span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">color_index</span> <span class=\"tok-o\">+</span> <span class=\"tok-mi\">1</span><span class=\"tok-p\">)</span> <span class=\"tok-o\">%</span> <span class=\"tok-nb\">len</span><span class=\"tok-p\">(</span><span class=\"tok-n\">PALETTE</span><span class=\"tok-p\">)</span>\n\n    <span class=\"tok-k\">def</span> <span class=\"tok-nf\">draw_stroke</span><span class=\"tok-p\">(</span><span class=\"tok-bp\">self</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">stroke</span><span class=\"tok-p\">):</span>\n        <span class=\"tok-n\">start</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">end</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">color</span> <span class=\"tok-o\">=</span> <span class=\"tok-n\">stroke</span>\n        <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">pen</span><span class=\"tok-o\">.</span><span class=\"tok-n\">penup</span><span class=\"tok-p\">()</span>\n        <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">pen</span><span class=\"tok-o\">.</span><span class=\"tok-n\">goto</span><span class=\"tok-p\">(</span><span class=\"tok-n\">start</span><span class=\"tok-p\">)</span>\n        <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">pen</span><span class=\"tok-o\">.</span><span class=\"tok-n\">pendown</span><span class=\"tok-p\">()</span>\n        <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">pen</span><span class=\"tok-o\">.</span><span class=\"tok-n\">color</span><span class=\"tok-p\">(</span><span class=\"tok-n\">color</span><span class=\"tok-p\">)</span>\n        <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">pen</span><span class=\"tok-o\">.</span><span class=\"tok-n\">goto</span><span class=\"tok-p\">(</span><span class=\"tok-n\">end</span><span class=\"tok-p\">)</span>\n\n    <span class=\"tok-k\">def</span> <span class=\"tok-nf\">move</span><span class=\"tok-p\">(</span><span class=\"tok-bp\">self</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">dx</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">dy</span><span class=\"tok-p\">):</span>\n<span class=\"tok-w\">        </span><span class=\"tok-sd\">&quot;&quot;&quot;Draw one stroke and push it onto the history stack.&quot;&quot;&quot;</span>\n        <span class=\"tok-n\">start</span> <span class=\"tok-o\">=</span> <span class=\"tok-p\">(</span><span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">x</span><span class=\"tok-p\">,</span> <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">y</span><span class=\"tok-p\">)</span>\n        <span class=\"tok-n\">end</span> <span class=\"tok-o\">=</span> <span class=\"tok-p\">(</span><span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">x</span> <span class=\"tok-o\">+</span> <span class=\"tok-n\">dx</span><span class=\"tok-p\">,</span> <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">y</span> <span class=\"tok-o\">+</span> <span class=\"tok-n\">dy</span><span class=\"tok-p\">)</span>\n        <span class=\"tok-n\">stroke</span> <span class=\"tok-o\">=</span> <span class=\"tok-p\">(</span><span class=\"tok-n\">start</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">end</span><span class=\"tok-p\">,</span> <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">color</span><span class=\"tok-p\">())</span>\n        <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">history</span><span class=\"tok-o\">.</span><span class=\"tok-n\">push</span><span class=\"tok-p\">(</span><span class=\"tok-n\">stroke</span><span class=\"tok-p\">)</span>\n        <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">x</span><span class=\"tok-p\">,</span> <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">y</span> <span class=\"tok-o\">=</span> <span class=\"tok-n\">end</span>\n        <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">draw_stroke</span><span class=\"tok-p\">(</span><span class=\"tok-n\">stroke</span><span class=\"tok-p\">)</span>\n\n    <span class=\"tok-k\">def</span> <span class=\"tok-nf\">undo</span><span class=\"tok-p\">(</span><span class=\"tok-bp\">self</span><span class=\"tok-p\">):</span>\n<span class=\"tok-w\">        </span><span class=\"tok-sd\">&quot;&quot;&quot;Pop the last stroke and redraw everything that is left.&quot;&quot;&quot;</span>\n        <span class=\"tok-n\">stroke</span> <span class=\"tok-o\">=</span> <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">history</span><span class=\"tok-o\">.</span><span class=\"tok-n\">pop</span><span class=\"tok-p\">()</span>\n        <span class=\"tok-k\">if</span> <span class=\"tok-n\">stroke</span> <span class=\"tok-ow\">is</span> <span class=\"tok-kc\">None</span><span class=\"tok-p\">:</span>\n            <span class=\"tok-k\">return</span>  <span class=\"tok-c1\"># nothing to undo</span>\n        <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">x</span><span class=\"tok-p\">,</span> <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">y</span> <span class=\"tok-o\">=</span> <span class=\"tok-n\">stroke</span><span class=\"tok-p\">[</span><span class=\"tok-mi\">0</span><span class=\"tok-p\">]</span>  <span class=\"tok-c1\"># go back to where that stroke started</span>\n        <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">pen</span><span class=\"tok-o\">.</span><span class=\"tok-n\">clear</span><span class=\"tok-p\">()</span>\n        <span class=\"tok-k\">for</span> <span class=\"tok-n\">old_stroke</span> <span class=\"tok-ow\">in</span> <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">history</span><span class=\"tok-o\">.</span><span class=\"tok-n\">items</span><span class=\"tok-p\">:</span>\n            <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">draw_stroke</span><span class=\"tok-p\">(</span><span class=\"tok-n\">old_stroke</span><span class=\"tok-p\">)</span>\n        <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">pen</span><span class=\"tok-o\">.</span><span class=\"tok-n\">penup</span><span class=\"tok-p\">()</span>\n        <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">pen</span><span class=\"tok-o\">.</span><span class=\"tok-n\">goto</span><span class=\"tok-p\">(</span><span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">x</span><span class=\"tok-p\">,</span> <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">y</span><span class=\"tok-p\">)</span>\n\n    <span class=\"tok-c1\"># Small methods with no inputs, so we can give them to screen.onkey</span>\n    <span class=\"tok-k\">def</span> <span class=\"tok-nf\">up</span><span class=\"tok-p\">(</span><span class=\"tok-bp\">self</span><span class=\"tok-p\">):</span>\n        <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">move</span><span class=\"tok-p\">(</span><span class=\"tok-mi\">0</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">STEP</span><span class=\"tok-p\">)</span>\n\n    <span class=\"tok-k\">def</span> <span class=\"tok-nf\">down</span><span class=\"tok-p\">(</span><span class=\"tok-bp\">self</span><span class=\"tok-p\">):</span>\n        <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">move</span><span class=\"tok-p\">(</span><span class=\"tok-mi\">0</span><span class=\"tok-p\">,</span> <span class=\"tok-o\">-</span><span class=\"tok-n\">STEP</span><span class=\"tok-p\">)</span>\n\n    <span class=\"tok-k\">def</span> <span class=\"tok-nf\">left</span><span class=\"tok-p\">(</span><span class=\"tok-bp\">self</span><span class=\"tok-p\">):</span>\n        <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">move</span><span class=\"tok-p\">(</span><span class=\"tok-o\">-</span><span class=\"tok-n\">STEP</span><span class=\"tok-p\">,</span> <span class=\"tok-mi\">0</span><span class=\"tok-p\">)</span>\n\n    <span class=\"tok-k\">def</span> <span class=\"tok-nf\">right</span><span class=\"tok-p\">(</span><span class=\"tok-bp\">self</span><span class=\"tok-p\">):</span>\n        <span class=\"tok-bp\">self</span><span class=\"tok-o\">.</span><span class=\"tok-n\">move</span><span class=\"tok-p\">(</span><span class=\"tok-n\">STEP</span><span class=\"tok-p\">,</span> <span class=\"tok-mi\">0</span><span class=\"tok-p\">)</span>\n\n\n<span class=\"tok-k\">def</span> <span class=\"tok-nf\">show_help</span><span class=\"tok-p\">(</span><span class=\"tok-n\">writer</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">painter</span><span class=\"tok-p\">):</span>\n<span class=\"tok-w\">    </span><span class=\"tok-sd\">&quot;&quot;&quot;Write the keys and the color NAME (so color is never the only clue).&quot;&quot;&quot;</span>\n    <span class=\"tok-n\">writer</span><span class=\"tok-o\">.</span><span class=\"tok-n\">clear</span><span class=\"tok-p\">()</span>\n    <span class=\"tok-n\">writer</span><span class=\"tok-o\">.</span><span class=\"tok-n\">penup</span><span class=\"tok-p\">()</span>\n    <span class=\"tok-n\">writer</span><span class=\"tok-o\">.</span><span class=\"tok-n\">goto</span><span class=\"tok-p\">(</span><span class=\"tok-o\">-</span><span class=\"tok-mi\">380</span><span class=\"tok-p\">,</span> <span class=\"tok-mi\">260</span><span class=\"tok-p\">)</span>\n    <span class=\"tok-n\">name</span> <span class=\"tok-o\">=</span> <span class=\"tok-n\">COLOR_NAMES</span><span class=\"tok-p\">[</span><span class=\"tok-n\">painter</span><span class=\"tok-o\">.</span><span class=\"tok-n\">color_index</span><span class=\"tok-p\">]</span>\n    <span class=\"tok-n\">writer</span><span class=\"tok-o\">.</span><span class=\"tok-n\">write</span><span class=\"tok-p\">(</span><span class=\"tok-sa\">f</span><span class=\"tok-s2\">&quot;Arrows: draw   c: color (</span><span class=\"tok-si\">{</span><span class=\"tok-n\">name</span><span class=\"tok-si\">}</span><span class=\"tok-s2\">)   u: undo   strokes: </span><span class=\"tok-si\">{</span><span class=\"tok-n\">painter</span><span class=\"tok-o\">.</span><span class=\"tok-n\">history</span><span class=\"tok-o\">.</span><span class=\"tok-n\">size</span><span class=\"tok-p\">()</span><span class=\"tok-si\">}</span><span class=\"tok-s2\">&quot;</span><span class=\"tok-p\">,</span>\n                 <span class=\"tok-n\">font</span><span class=\"tok-o\">=</span><span class=\"tok-p\">(</span><span class=\"tok-s2\">&quot;Arial&quot;</span><span class=\"tok-p\">,</span> <span class=\"tok-mi\">14</span><span class=\"tok-p\">,</span> <span class=\"tok-s2\">&quot;normal&quot;</span><span class=\"tok-p\">))</span>\n\n\n<span class=\"tok-k\">if</span> <span class=\"tok-vm\">__name__</span> <span class=\"tok-o\">==</span> <span class=\"tok-s2\">&quot;__main__&quot;</span><span class=\"tok-p\">:</span>\n    <span class=\"tok-n\">screen</span> <span class=\"tok-o\">=</span> <span class=\"tok-n\">turtle</span><span class=\"tok-o\">.</span><span class=\"tok-n\">Screen</span><span class=\"tok-p\">()</span>\n    <span class=\"tok-n\">screen</span><span class=\"tok-o\">.</span><span class=\"tok-n\">title</span><span class=\"tok-p\">(</span><span class=\"tok-s2\">&quot;Undo Paint&quot;</span><span class=\"tok-p\">)</span>\n    <span class=\"tok-n\">pen</span> <span class=\"tok-o\">=</span> <span class=\"tok-n\">turtle</span><span class=\"tok-o\">.</span><span class=\"tok-n\">Turtle</span><span class=\"tok-p\">()</span>\n    <span class=\"tok-n\">pen</span><span class=\"tok-o\">.</span><span class=\"tok-n\">shape</span><span class=\"tok-p\">(</span><span class=\"tok-s2\">&quot;circle&quot;</span><span class=\"tok-p\">)</span>\n    <span class=\"tok-n\">pen</span><span class=\"tok-o\">.</span><span class=\"tok-n\">shapesize</span><span class=\"tok-p\">(</span><span class=\"tok-mf\">0.5</span><span class=\"tok-p\">)</span>\n    <span class=\"tok-n\">pen</span><span class=\"tok-o\">.</span><span class=\"tok-n\">pensize</span><span class=\"tok-p\">(</span><span class=\"tok-mi\">5</span><span class=\"tok-p\">)</span>\n    <span class=\"tok-n\">pen</span><span class=\"tok-o\">.</span><span class=\"tok-n\">speed</span><span class=\"tok-p\">(</span><span class=\"tok-mi\">0</span><span class=\"tok-p\">)</span>\n    <span class=\"tok-n\">writer</span> <span class=\"tok-o\">=</span> <span class=\"tok-n\">turtle</span><span class=\"tok-o\">.</span><span class=\"tok-n\">Turtle</span><span class=\"tok-p\">()</span>\n    <span class=\"tok-n\">writer</span><span class=\"tok-o\">.</span><span class=\"tok-n\">hideturtle</span><span class=\"tok-p\">()</span>\n    <span class=\"tok-n\">painter</span> <span class=\"tok-o\">=</span> <span class=\"tok-n\">Painter</span><span class=\"tok-p\">(</span><span class=\"tok-n\">pen</span><span class=\"tok-p\">)</span>\n\n    <span class=\"tok-k\">def</span> <span class=\"tok-nf\">key</span><span class=\"tok-p\">(</span><span class=\"tok-n\">action</span><span class=\"tok-p\">):</span>\n<span class=\"tok-w\">        </span><span class=\"tok-sd\">&quot;&quot;&quot;Wrap an action so the help line updates after every key.&quot;&quot;&quot;</span>\n        <span class=\"tok-k\">def</span> <span class=\"tok-nf\">handler</span><span class=\"tok-p\">():</span>\n            <span class=\"tok-n\">action</span><span class=\"tok-p\">()</span>\n            <span class=\"tok-n\">show_help</span><span class=\"tok-p\">(</span><span class=\"tok-n\">writer</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">painter</span><span class=\"tok-p\">)</span>\n        <span class=\"tok-k\">return</span> <span class=\"tok-n\">handler</span>\n\n    <span class=\"tok-n\">screen</span><span class=\"tok-o\">.</span><span class=\"tok-n\">onkey</span><span class=\"tok-p\">(</span><span class=\"tok-n\">key</span><span class=\"tok-p\">(</span><span class=\"tok-n\">painter</span><span class=\"tok-o\">.</span><span class=\"tok-n\">up</span><span class=\"tok-p\">),</span> <span class=\"tok-s2\">&quot;Up&quot;</span><span class=\"tok-p\">)</span>\n    <span class=\"tok-n\">screen</span><span class=\"tok-o\">.</span><span class=\"tok-n\">onkey</span><span class=\"tok-p\">(</span><span class=\"tok-n\">key</span><span class=\"tok-p\">(</span><span class=\"tok-n\">painter</span><span class=\"tok-o\">.</span><span class=\"tok-n\">down</span><span class=\"tok-p\">),</span> <span class=\"tok-s2\">&quot;Down&quot;</span><span class=\"tok-p\">)</span>\n    <span class=\"tok-n\">screen</span><span class=\"tok-o\">.</span><span class=\"tok-n\">onkey</span><span class=\"tok-p\">(</span><span class=\"tok-n\">key</span><span class=\"tok-p\">(</span><span class=\"tok-n\">painter</span><span class=\"tok-o\">.</span><span class=\"tok-n\">left</span><span class=\"tok-p\">),</span> <span class=\"tok-s2\">&quot;Left&quot;</span><span class=\"tok-p\">)</span>\n    <span class=\"tok-n\">screen</span><span class=\"tok-o\">.</span><span class=\"tok-n\">onkey</span><span class=\"tok-p\">(</span><span class=\"tok-n\">key</span><span class=\"tok-p\">(</span><span class=\"tok-n\">painter</span><span class=\"tok-o\">.</span><span class=\"tok-n\">right</span><span class=\"tok-p\">),</span> <span class=\"tok-s2\">&quot;Right&quot;</span><span class=\"tok-p\">)</span>\n    <span class=\"tok-n\">screen</span><span class=\"tok-o\">.</span><span class=\"tok-n\">onkey</span><span class=\"tok-p\">(</span><span class=\"tok-n\">key</span><span class=\"tok-p\">(</span><span class=\"tok-n\">painter</span><span class=\"tok-o\">.</span><span class=\"tok-n\">next_color</span><span class=\"tok-p\">),</span> <span class=\"tok-s2\">&quot;c&quot;</span><span class=\"tok-p\">)</span>\n    <span class=\"tok-n\">screen</span><span class=\"tok-o\">.</span><span class=\"tok-n\">onkey</span><span class=\"tok-p\">(</span><span class=\"tok-n\">key</span><span class=\"tok-p\">(</span><span class=\"tok-n\">painter</span><span class=\"tok-o\">.</span><span class=\"tok-n\">undo</span><span class=\"tok-p\">),</span> <span class=\"tok-s2\">&quot;u&quot;</span><span class=\"tok-p\">)</span>\n    <span class=\"tok-n\">screen</span><span class=\"tok-o\">.</span><span class=\"tok-n\">listen</span><span class=\"tok-p\">()</span>\n    <span class=\"tok-n\">show_help</span><span class=\"tok-p\">(</span><span class=\"tok-n\">writer</span><span class=\"tok-p\">,</span> <span class=\"tok-n\">painter</span><span class=\"tok-p\">)</span>\n    <span class=\"tok-n\">turtle</span><span class=\"tok-o\">.</span><span class=\"tok-n\">done</span><span class=\"tok-p\">()</span>"
